@startuml Project01_Activity_Environment
title How the environment is generated

start
:Set up a 100m x 100m field;
:Divide the field into a grid of patches;

partition "Coloring the patches (at the start)" {
  if (Is the transition abrupt?) then (yes)
    :Split the field in half —\none side pure black,\nthe other side pure white;
  else (gradual)
    :Blend the colors smoothly\nfrom black on one side\nto white on the other;
  endif
}

if (Should the environment\nchange over time? [Extension 2]) then (yes)
  partition "While the simulation runs" {
    repeat
      :Shift the black-to-white pattern\nacross the field a little;
    repeat while (Simulation still running?) is (yes)
    ->no;
  }
  stop
else (no)
  :Environment stays the same\nfor the whole simulation;
  stop
endif

@enduml
