@startuml Project01_ClassDiagram
title Butterfly Coloration Evolution ABM — High-level overview

skinparam classAttributeIconSize 0
skinparam classFontStyle bold

class Global <<global>> {
  reproduction rate
  predation strength
  environment gradient settings
  --
  {action} init()
}

class patch_env <<grid>> {
  background color
  --
  {reflex} slide_gradient()
}
note right of patch_env
  Extension 2: background color
  can drift over time
end note

class butterfly <<species>> {
  color (black / white / gray)
  --
  {reflex} move()
  {reflex} reproduce()
  {reflex} die_natural()
}
note right of butterfly
  Color is inherited from two parents:
  black + black -> black
  white + white -> white
  mixed -> gray
end note

class predator <<species>> {
  --
  {reflex} hunt()
}
note right of predator
  Hunts by camouflage,
  or by color popularity (Extension 1)
end note

Global "1" *-- "many" patch_env : environment
Global "1" o.. "many" butterfly : population
Global "1" o.. "many" predator : population

predator ..> butterfly : hunts
butterfly ..> patch_env : blends into
predator ..> patch_env : judges camouflage against

@enduml
