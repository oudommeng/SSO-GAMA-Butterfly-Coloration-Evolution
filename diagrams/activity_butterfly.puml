@startuml Project01_Activity_Butterfly
title Butterfly agent — per-cycle behavior (skills: [moving])

start
:Cycle tick for this butterfly;

' --- reflex move() ---
:move() — do wander(amplitude: 30°, speed: 0.5);

' --- reflex reproduce() ---
if (flip(reproduction_rate)\nAND population < carrying_capacity?) then (yes)
  :find mates = other butterflies\nwithin 5m (excluding self);
  if (mates found?) then (yes)
    :pick one random mate;
    :a1 = self.transmit_allele();
    :a2 = mate.transmit_allele();
    note right
      transmit_allele():
      BB -> always "B"
      WW -> always "W"
      BW -> "B" or "W" (50/50)
    end note
    if (a1 = "B" and a2 = "B"?) then (yes)
      :child genotype = "BB" (black);
    elseif (a1 = "W" and a2 = "W"?) then (yes)
      :child genotype = "WW" (white);
    else (no)
      :child genotype = "BW" (gray);
    endif
    :create new butterfly\nat parent's location;
    :nb_reproductions += 1;
  else (no mates nearby)
  endif
else (no)
endif

' --- reflex die_natural() ---
if (flip(natural_death_proba)?) then (yes)
  :nb_deaths_natural += 1;
  :die;
  stop
else (no)
endif

:end of cycle (still alive);
stop

@enduml
